    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:start": "bash scripts/dev-db.sh start",
    "db:stop": "bash scripts/dev-db.sh stop",
    "db:reset": "bash scripts/dev-db.sh reset",
    "db:migrate": "bash scripts/dev-db.sh migrate",
    "test:e2e": "node tests/e2e/parcours.mjs",
    "test:e2e:relecture": "node tests/e2e/relecture.mjs",
    "test:e2e:connexion": "node tests/e2e/connexion-supabase.mjs",
    "supabase:migrate": "node --env-file-if-exists=.env.supabase scripts/supabase/migrate.mjs",
    "supabase:setup": "node --env-file-if-exists=.env.supabase scripts/supabase/setup.mjs",
    "supabase:check": "node --env-file-if-exists=.env.supabase scripts/supabase/check.mjs",
    "test:e2e:rgpd": "node tests/e2e/rgpd.mjs",
    "test:e2e:envois": "node tests/e2e/envois.mjs",
