# Développement local : npm run db:start, puis copier ce fichier en .env.local.
DATABASE_URL=postgres://postgres@localhost:54322/crm
SESSION_SECRET=remplacer-par-une-longue-chaine-aleatoire-de-32-caracteres-min
AUTH_MODE=dev
STORAGE_DIR=.local/storage

# Production (à remplir quand Supabase et Vercel seront créés). Ne jamais committer .env.local.
# DATABASE_URL=            connexion Postgres Supabase (serveur uniquement)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ANTHROPIC_API_KEY=       lecture des emails, notices et comptes rendus par l'IA
# BREVO_API_KEY=           envoi réel des emails de la file d'envoi
