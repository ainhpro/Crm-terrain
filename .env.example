# ── Développement local ───────────────────────────────────────────────
# npm run db:start, puis copier ce fichier en .env.local (jamais committé).
DATABASE_URL=postgres://postgres@localhost:54322/crm
SESSION_SECRET=remplacer-par-une-longue-chaine-aleatoire-de-32-caracteres-min
AUTH_MODE=dev
STORAGE_DIR=.local/storage

# ── Production (Vercel, région Francfort) ─────────────────────────────
# Tout est lu côté serveur uniquement : aucune variable NEXT_PUBLIC_, aucune clé dans le navigateur.
# Dès que SUPABASE_URL et SUPABASE_ANON_KEY sont présents, la connexion par email seul (AUTH_MODE=dev)
# est désactivée : seule la connexion Supabase (lien ou code reçu par email) fonctionne.
#
# APP_URL=https://<domaine>                       adresse publique (liens des emails de connexion)
# SESSION_SECRET=<64 caractères aléatoires>       signe la session de l'application
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=<clé publique>                appels Auth depuis le serveur
# SUPABASE_SERVICE_ROLE_KEY=<clé secrète>         Storage uniquement (traitement « fichiers »)
# SUPABASE_STORAGE_BUCKET=fichiers                facultatif
# DATABASE_URL=<pooler Supabase, mode transaction, port 6543>   accès de l'application (rôle postgres,
#                                                 puis rôle authenticated + identité par transaction : la RLS s'applique)
# DATABASE_SSL_CA=<certificat PEM de Supabase>    obligatoire en production (Project Settings › Database › SSL)
# DB_POOL_MAX=3                                   connexions par instance Vercel
#
# ANTHROPIC_API_KEY=       comptes rendus et emails de demande lus par l'IA (Claude, côté serveur) ; sans elle, règles locales
# BREVO_API_KEY=           envoi réel des emails de la file d'envoi (sans elle, rien ne part)
# BREVO_SENDER_EMAIL=      adresse d'expédition d'un domaine authentifié dans Brevo (SPF, DKIM)
# BREVO_SENDER_NAME=       facultatif (par défaut : le nom de l'entreprise de chaque message)
# CRON_SECRET=<32 caractères aléatoires>   protège le passage de rattrapage /api/envois (Vercel Cron)

# ── Scripts Supabase (npm run supabase:*) ─────────────────────────────
# Dans l'environnement, ou dans un fichier .env.supabase (jamais committé) :
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, APP_URL, DATABASE_SSL_CA,
# SUPABASE_DB_URL=<pooler Supabase, mode session, port 5432>   migrations
# SUPABASE_ACCESS_TOKEN=<jeton personnel Supabase>              configuration Auth (npm run supabase:setup)
# SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS / SMTP_SENDER_EMAIL / SMTP_SENDER_NAME   facultatif (Brevo)
